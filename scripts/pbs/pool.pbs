#!/bin/bash
# Parallel revision pool (see pool.sh). Submit with scripts/pbs/submit_pool.sh, which
# sets the GPU count and passes the environment explicitly (no -V: a pool resubmitted
# from a compute node must not inherit that node's CUDA_VISIBLE_DEVICES).
#PBS -N rcg_pool
#PBS -q a100q
#PBS -P 20260203
#PBS -l select=1:ncpus=16:ngpus=2:mem=128gb
#PBS -l walltime=100:00:00
#PBS -j oe
ROOT="${RCG_ROOT:-${PBS_O_WORKDIR:?Submit from the repository root}}"
STATE="${RCG_POOL_STATE:-${RCG_RESULTS_ROOT:-$ROOT/assets/results/revision-a100-native}/.pool}"
# Verdicts for the keeper: pool.sh writes 0/75/1; anything else (setup error, crash) is
# recorded as 2 so the keeper stops after repeated errors instead of resubmitting forever.
error_verdict() {
    mkdir -p "$STATE"
    printf '2 %s %s rc=%s\n' "${PBS_JOBID:-local}" "$(date +%s)" "$1" > "$STATE/last_exit"
    echo $(( $(cat "$STATE/errors" 2>/dev/null || echo 0) + 1 )) > "$STATE/errors"
}
# Mark this job as started (pool_keeper.sh checks it against this job's submission mark;
# the job may start before submit_pool.sh has written that mark).
if [[ "${DRY:-0}" != 1 ]]; then
    mkdir -p "$STATE/started.d"; touch "$STATE/started.d/${PBS_JOBID:-local}"
    rm -f "$STATE/unstarted.d/${PBS_JOBID:-local}"
fi
[[ -x "${RCG_PYTHON:-}" ]] || {
    echo "Set RCG_PYTHON to the rcg-a100 interpreter (absolute path)" >&2; error_verdict 2; exit 2; }
export PATH="$(dirname "$RCG_PYTHON"):/opt/pbs/bin:$PATH"
export WANDB_MODE="${WANDB_MODE:-offline}" RCG_TARGET_GPU="${RCG_TARGET_GPU:-a100_80gb}"
export HF_HOME="${HF_HOME:-$ROOT/assets/cache/huggingface}" NLTK_DATA="${NLTK_DATA:-$ROOT/assets/cache/nltk_data}"
rc=0
bash "$ROOT/scripts/pbs/pool.sh" || rc=$?
[[ "${DRY:-0}" == 1 ]] && exit "$rc"
case "$rc" in
    0|1|75) rm -f "$STATE/errors" ;;
    *) error_verdict "$rc" ;;
esac
# Walltime reached with work left: queue the continuation now (it resumes from the
# checkpoints) unless the user asked the campaign to stop. If qsub is refused, the
# login-node cron keeper retries.
if [[ "$rc" == 75 && "${RCG_POOL_RESUBMIT:-1}" == 1 && ! -e "$STATE/stop" ]]; then
    RCG_ROOT="$ROOT" bash "$ROOT/scripts/pbs/submit_pool.sh" --continue || true
fi
exit "$rc"
